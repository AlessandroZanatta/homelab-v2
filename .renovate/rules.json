{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Extend security:minimumReleaseAgeNpm embargo from 3 to 7 days",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Ignore images from registry.kalexlab.xyz since it is not exposed",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.kalexlab.xyz{/,}**"],
      "enabled": false
    },
    {
      "description": "Automerge Talos and Kubernetes updates only early on weekends",
      "matchPackageNames": [
        "ghcr.io/siderolabs/talos",
        "ghcr.io/siderolabs/kubelet"
      ],
      "schedule": ["at any time"],
      "automerge": true,
      "automergeType": "pr",
      "automergeSchedule": ["after 1am on saturday", "after 1am on sunday"]
    },
    {
      "description": "Auto-merge grafana.com dashboard revision bumps",
      "matchDatasources": ["custom.grafana-dashboards"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Keep CNPG image and barman serverName in one PR",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      "groupName": "cloudnative-pg postgres"
    },
    {
      "description": "Keep MariaDB image and backup S3 prefix in one PR",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/mariadb/mariadb"],
      "groupName": "mariadb"
    },
    {
      "description": "OpenWrt releases: PR only, upgrade is done manually via attended sysupgrade",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["openwrt/openwrt"],
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "automerge": false,
      "addLabels": ["renovate/openwrt"],
      "prBodyNotes": [
        "⚠️ Not applied automatically: run attended sysupgrade on the router (LuCI → System → Attended Sysupgrade, or `owut upgrade`), then merge."
      ]
    },
    {
      "description": "Keep gatus-sidecar image and CRDs in one commit",
      "matchPackageNames": [
        "ghcr.io/alessandrozanatta/gatus-sidecar",
        "AlessandroZanatta/gatus-sidecar"
      ],
      "groupName": "gatus-sidecar"
    }
  ]
}
