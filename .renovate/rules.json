{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Ignore images from registry.kalexlab.xyz since it is not exposed",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.kalexlab.xyz{/,}**"],
      "enabled": false
    },
    {
      "description": "Automerge Talos and Kubernetes updates only early on weekends",
      "matchPackageNames": [
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/kubelet"
      ],
      "automerge": true,
      "automergeSchedule": ["after 11pm on friday", "on saturday"]
    },
    {
      "description": "Auto-merge grafana.com dashboard revision bumps",
      "matchDatasources": ["custom.grafana-dashboards"],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
