# 2.4GHz device
config wifi-device '2ghz'
	option type 'mac80211'
	option path '1e140000.pcie/pci0000:00/0000:00:01.0/0000:02:00.0'
	option channel 'auto'
	option band '2g'
	option htmode 'HE40'
	option cell_density '0'

# 5GHz device
config wifi-device '5ghz'
	option type 'mac80211'
	option path '1e140000.pcie/pci0000:00/0000:00:01.0/0000:02:00.0+1'
	option channel 'auto'
	option band '5g'
	option htmode 'HE80'
	option cell_density '0'

# LAN
config wifi-iface 'main5'
	option device '5ghz'
	option mode 'ap'
	option ssid 'Home'
	option encryption 'sae-mixed'
	option key '${WIRELESS_MAIN_KEY}'
	option wpa_disable_eapol_key_retries '1'
	option network 'lan'

config wifi-iface 'main2'
	option device '2ghz'
	option mode 'ap'
	option ssid 'Home'
	option encryption 'sae-mixed'
	option key '${WIRELESS_MAIN_KEY}'
	option wpa_disable_eapol_key_retries '1'
	option network 'lan'

# SEGREGATED
config wifi-iface 'segregated2'
	option device '2ghz'
	option mode 'ap'
	option ssid 'Segregated'
	option encryption 'sae-mixed'
	option key '${WIRELESS_SEGREGATED_KEY}'
	option wpa_disable_eapol_key_retries '1'
	option network 'segregated'
	option isolate '1'
